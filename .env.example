# VORO Configuration File Example

# LLM Configuration
LLM_PROVIDER=ollama
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_HOST=http://localhost:11434

# System Prompts & Tones
UI_AI_TONE=Conversational (Hinglish)

# Audio & Hardware
UI_TTS_OUTPUT_DEVICE=Default System Device
UI_TTS_VOLUME=100
UI_TTS_RATE=+0%

# Behavior
UI_SHOW_IN_TASKBAR=False
UI_SHOW_TRAY=True
UI_ALWAYS_ON_TOP=True

# File Paths
STT_MODEL_DIR=E:\Noise\models
